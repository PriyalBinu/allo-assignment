datasource db {
  provider = "postgresql"
  url      = env("postgresql://postgres:[Priyal@1102]@db.lvbjwlvazmegiaynkmuh.supabase.co:5432/postgres")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id        String   @id @default(uuid())
  name      String
  stocks    Stock[]
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  stocks    Stock[]
}

model Stock {
  id            String   @id @default(uuid())
  productId     String
  warehouseId   String
  total         Int
  reserved      Int      @default(0)

  product       Product  @relation(fields: [productId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
}

model Reservation {
  id           String   @id @default(uuid())
  productId    String
  warehouseId  String
  quantity     Int
  status       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}